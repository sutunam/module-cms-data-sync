{
    "name": "sutunam/module-cms-data-sync",
    "description": "This extension will allow to SYNC CMS pages or blocks from one website to other.",
    "require": {
        "magento/framework": ">=100.1.0",
        "php": ">=8.0",
        "magento/module-cms": ">=100.1.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3",
        "bitexpert/phpstan-magento": "^0.30.1",
        "phpstan/phpstan": "^1.10",
        "phpstan/extension-installer": "^1.3",
        "magento/magento-coding-standard": "^31.0",
        "friendsofphp/php-cs-fixer": "^3.62"
    },
    "license": [
        "Proprietary"
    ],
    "autoload": {
        "psr-4": {
            "Sutunam\\CmsDataSync\\": ""
        },
        "files": [
            "registration.php"
        ]
    },
    "type": "magento2-module",
    "version": "1.0.4",
    "repositories": {
        "magento": {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=-1",
        "phpcs": "vendor/bin/phpcs --ignore=vendor,*.xml,*.less,*.js --standard=Magento2 ./",
        "post-install-cmd": [
            "([ $COMPOSER_DEV_MODE -eq 0 ] || vendor/bin/phpcs --config-set installed_paths vendor/magento/magento-coding-standard/,vendor/phpcompatibility/php-compatibility)"
        ],
        "post-update-cmd": [
            "([ $COMPOSER_DEV_MODE -eq 0 ] || vendor/bin/phpcs --config-set installed_paths vendor/magento/magento-coding-standard/,vendor/phpcompatibility/php-compatibility)"
        ]
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "magento/composer-dependency-version-audit-plugin": false
        }
    }

}
