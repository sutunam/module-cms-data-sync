{
    "name": "sutunam/module-cms-data-sync",
    "description": "This extension will allow to sync CMS pages or blocks from one website to other.",
    "type": "magento2-module",
    "version": "1.1.0",
    "require": {
        "magento/framework": "*",
        "magento/module-cms": ">=100.1.0",
        "sutunam/module-base": "^2.0"
    },
    "license": [
        "GPL-3.0-or-later"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Sutunam\\CmsDataSync\\": ""
        }
    },
    "repositories": {
        "magento": {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "magento/composer-dependency-version-audit-plugin": false
        }
    }
}
