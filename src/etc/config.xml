<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <cms_data_sync>
            <connection>
                <enabled>1</enabled>
                <password backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <sync_media>0</sync_media>
                <media_type>jpg,jpeg,png,gif</media_type>
                <remote_media_subdir>media/</remote_media_subdir>
                <is_overwrite>0</is_overwrite>
            </connection>
        </cms_data_sync>
    </default>
</config>
