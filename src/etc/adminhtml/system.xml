<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="sutunam" translate="label" sortOrder="999998">
            <label>Sutunam</label>
        </tab>
        <section id="cms_data_sync" translate="label" showInDefault="1" showInWebsite="1" showInStore="0">
            <label>Cms Data Sync</label>
            <tab>sutunam</tab>
            <resource>Sutunam_CmsDataSync::config</resource>
            <group id="connection" type="text" sortOrder="0"
                   showInDefault="1" showInWebsite="0" showInStore="0" translate="label">
                <label>Connection Setting</label>
                <field id="enabled" type="select" sortOrder="10" translate="label"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                </field>
                <field id="site_name" type="text" translate="label comment"
                       sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Website name</label>
                    <validate>required-entry</validate>
                    <comment><![CDATA[Live/Staging/Local ..etc]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="site_url" type="text" sortOrder="30" translate="label comment"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Website URL</label>
                    <comment><![CDATA[For Example: http://magento.com/ (slash at the end of URL is required)]]></comment>
                    <validate>validate-url required-entry</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="username" type="text" sortOrder="40" translate="label comment"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Username</label>
                    <validate>required-entry</validate>
                    <comment><![CDATA[Enter Admin account of target website]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="password" type="obscure" translate="label comment"
                       sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Password</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <validate>required-entry</validate>
                    <comment><![CDATA[Enter Admin password of target website]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="cms_data_sync_test_connect_wizard" translate="button_label" sortOrder="60"
                       showInDefault="1" showInWebsite="0">
                    <label/>
                    <button_label>Test Connection</button_label>
                    <frontend_model>Sutunam\CmsDataSync\Block\Adminhtml\System\Config\TestConnection</frontend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="sync_media" type="select" translate="label"
                       sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Sync Media</label>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="media_type" type="text" sortOrder="80" translate="label comment"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Media Type</label>
                    <comment><![CDATA[Media type allowed to be synced(Separated by comma). E.g: jpg,png,jpeg]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="sync_media">1</field>
                    </depends>
                </field>
                <field id="remote_media_subdir" type="text" sortOrder="100" translate="label comment"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Remote Media Sub Directory</label>
                    <comment><![CDATA[Sub folder store Media of target website inside Root Media Directory. E.g: media/]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="sync_media">1</field>
                    </depends>
                </field>
                <field id="is_overwrite" type="select" sortOrder="110" translate="label comment"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Is Overwrite</label>
                    <source_model>Magento\Config\Model\Config\Source\Enabledisable</source_model>
                    <comment><![CDATA[The content will be overwritten during synchronization if Yes.]]></comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
