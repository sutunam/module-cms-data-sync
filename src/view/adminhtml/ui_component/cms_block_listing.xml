<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <settings>
        <buttons>
            <button name="push_all" class="Sutunam\CmsDataSync\Block\Adminhtml\Listing\Buttons\PushAllCmsBlock" />
            <button name="pull_all" class="Sutunam\CmsDataSync\Block\Adminhtml\Listing\Buttons\PullAllCmsBlock" />
        </buttons>
    </settings>
    <listingToolbar name="listing_top">
        <massaction name="listing_massaction" class="Sutunam\CmsDataSync\Ui\Component\MassAction">
            <action name="sync_push">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to sync selected items?</message>
                        <title translate="true">Sync items</title>
                    </confirm>
                    <url path="cms_data_sync/action/massSync">
                        <param name="type">Block</param>
                        <param name="action">push</param>
                    </url>
                    <type>sync_push</type>
                    <label translate="true">Sync(Push)</label>
                </settings>
            </action>
            <action name="sync_pull">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to sync selected items?</message>
                        <title translate="true">Sync items</title>
                    </confirm>
                    <url path="cms_data_sync/action/massSync">
                        <param name="type">Block</param>
                        <param name="action">pull</param>
                    </url>
                    <type>sync_pull</type>
                    <label translate="true">Sync(Pull)</label>
                </settings>
            </action>
        </massaction>
    </listingToolbar>
</listing>
