<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="widget_instance" resource="default" engine="innodb">
        <column xsi:type="varchar" name="identifier" nullable="true" comment="Widget Identifier"/>
        <constraint xsi:type="unique" referenceId="WIDGET_INSTANCE_IDENTIFIER_STORE_IDS">
            <column name="identifier"/>
            <column name="store_ids"/>
        </constraint>
    </table>
</schema>
